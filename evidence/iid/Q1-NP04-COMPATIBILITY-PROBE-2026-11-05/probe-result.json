  "P-6 validation behaviour + content-identity determinism": {
    "ok": true,
    "detail": {
      "probes": {
        "empty portfolioId": {
          "rejected": true,
          "error": "PersistenceValidationError",
          "message": "portfolioId must be a non-empty string"
        },
        "whitespace portfolioId": {
          "rejected": false
        },
        "empty owner": {
          "rejected": true,
          "error": "PersistenceOwnershipError",
          "message": "owner.tenantId must be a non-empty string"
        },
        "missing canonicalPayload": {
          "rejected": true,
          "error": "PersistenceValidationError",
          "message": "canonicalPayload must be a string"
        },
        "falsy-ish parameter values": {
          "rejected": false
        }
      },
      "keyDeterministicAcrossStoresAndKeyOrder": true,
      "note": "portfolioId is TEXT NOT NULL with no format/emptiness constraint at the store; the IRR adapter supplies non-empty validation"
    }
  },
  "P-7 append with unchanged reportKey": {
    "ok": true,
    "detail": {
      "sameKeyAppend": {
        "accepted": true,
        "sameKeyAsParent": true,
        "version": 2
      },
      "note": "NP-04 does not suppress an unchanged-content append; the idempotency no-op in the IID design must therefore be enforced by the composer, not the store"
