diff --git a/tests/g3_flush_guard_connection_release.test.ts b/tests/g3_flush_guard_connection_release.test.ts
new file mode 100644
index 0000000..0584fef
--- /dev/null
+++ b/tests/g3_flush_guard_connection_release.test.ts
@@ -0,0 +1,172 @@
+/**
+ * Gate 3 — flush-guard connection release (Windows named-pipe transport).
+ *
+ * Regression for the native-Windows defect where every IPC request after the
+ * first successful one received zero bytes:
+ *
+ *   restoring an ACTIVE binding makes the next IPC request succeed again
+ *   → assert.ok(response.byteLength > 0)  FAILED on Windows (0 bytes)
+ *
+ * Mechanism (transport-independent, verified on AF_UNIX by forcing the
+ * flush-guard settlement policy):
+ *
+ *   `listenIpc` sets `server.maxConnections = 1` (C5.4 capacity 1). Node
+ *   decrements `server._connections` ONLY in `Socket._destroy`. On a Windows
+ *   byte-mode named pipe `socket.end()` is a `FlushFileBuffers`, not a
+ *   half-close, so a response written with `write()` + no close leaves the
+ *   server handle open forever. The single capacity slot is then never
+ *   released, and `net.js onconnection` drops every later connection before
+ *   the `connection` event is emitted — the peer sees a closed socket and
+ *   zero bytes.
+ *
+ *   A conforming peer therefore receives exactly one response and then loses
+ *   all service until the server is restarted. This suite pins the fix: the
+ *   handle is closed as soon as the single response has flushed, so each
+ *   request gets its own connection slot.
+ *
+ * The flush-guard policy is selected on Windows from the endpoint family; it
+ * is forced here so the same regression runs on POSIX CI.
+ */
+import { describe, it, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createConnection } from 'node:net';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { openDatabase, closeDatabase } from '../src/persistence/connection.js';
+import { ensureMigrations } from '../src/persistence/migration_ledger.js';
+import { GATE3_MIGRATIONS } from '../src/ipc/entrypoint.js';
+import { listenIpc, resolveEndpointTarget, type IpcHandle } from '../src/ipc/endpoint.js';
+import { createConnectionHandler } from '../src/ipc/dispatch.js';
+
+const HOST_PLATFORM: NodeJS.Platform = process.platform === 'win32' ? 'win32' : 'linux';
+const ENDPOINT_NAME = `iips-g3-release-${process.pid}`;
+
+function frameFor(value: unknown): Buffer {
+  const body = Buffer.from(JSON.stringify(value), 'utf8');
+  const prefix = Buffer.allocUnsafe(4);
+  prefix.writeUInt32BE(body.byteLength, 0);
+  return Buffer.concat([prefix, body]);
+}
+
+/**
+ * Frame-length-aware request helper: resolves on the first complete frame, on
+ * error, or on close — so a response that is delivered and then followed by a
+ * deterministic close is still observed in full.
+ */
+function call(endpointPath: string, envelope: unknown, timeoutMs = 5000): Promise<Buffer> {
+  return new Promise((resolve) => {
+    const socket = createConnection({ path: endpointPath });
+    const chunks: Buffer[] = [];
+    let settled = false;
+    const finish = (): void => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      socket.off('data', onData);
+      socket.off('error', onError);
+      socket.off('close', onClose);
+      resolve(Buffer.concat(chunks));
+      socket.destroy();
+    };
+    const onData = (chunk: Buffer): void => {
+      chunks.push(chunk);
+      const response = Buffer.concat(chunks);
+      if (response.byteLength < 4) return;
+      if (response.byteLength >= 4 + response.readUInt32BE(0)) finish();
+    };
+    const onError = (): void => finish();
+    const onClose = (): void => finish();
+    const timer = setTimeout(finish, timeoutMs);
+    socket.on('data', onData);
+    socket.on('error', onError);
+    socket.on('close', onClose);
+    socket.on('connect', () => socket.write(frameFor(envelope), () => socket.end()));
+  });
+}
+
+describe('g3 / T-A flush-guard connection release', () => {
+  let root: string;
+  let db: DatabaseSync;
+  let handle: IpcHandle;
+  let endpointPath: string;
+
+  before(async () => {
+    root = mkdtempSync(join(tmpdir(), 'g3-release-'));
+    db = openDatabase(join(root, 'store', 'ipd.db'));
+    ensureMigrations(db, GATE3_MIGRATIONS);
+    const now = new Date().toISOString();
+    db.prepare(
+      "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES ('b-1', 'operator', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+    db.prepare(
+      "INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) VALUES ('m-1', 'b-1', 'tenant-local', 'owner-local', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+
+    const target = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: join(root, 'state') },
+      HOST_PLATFORM,
+    );
+    endpointPath = target.path;
+    handle = await listenIpc(
+      target,
+      // Forced flush-guard: the Windows named-pipe settlement policy.
+      createConnectionHandler(db, { settlement: 'flush-guard' }),
+      { platform: HOST_PLATFORM },
+    );
+  });
+
+  after(async () => {
+    await handle.stop();
+    closeDatabase();
+    rmSync(root, { recursive: true, force: true });
+  });
+
+  it('serves every sequential request in one server lifetime, not just the first', async () => {
+    const envelope = { v: 1, op: 'portfolio.list' };
+    for (let attempt = 1; attempt <= 4; attempt += 1) {
+      const response = await call(endpointPath, envelope);
+      assert.ok(
+        response.byteLength > 0,
+        `request ${attempt} received a response (a leaked connection slot yields zero bytes here)`,
+      );
+      const body = JSON.parse(response.subarray(4).toString('utf8')) as Record<string, unknown>;
+      assert.equal(body.ok, true, `request ${attempt} returned a well-formed success frame`);
+      assert.equal(body.op, 'portfolio.list');
+    }
+  });
+
+  it('releases the single capacity slot between requests', async () => {
+    const before = await new Promise<number>((resolve) =>
+      handle.server.getConnections((error, count) => resolve(error ? -1 : count)),
+    );
+    assert.equal(before, 0, 'no connection is still counted against the capacity of one');
+
+    const response = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    assert.ok(response.byteLength > 0);
+
+    await new Promise((resolve) => setTimeout(resolve, 25));
+    const after = await new Promise<number>((resolve) =>
+      handle.server.getConnections((error, count) => resolve(error ? -1 : count)),
+    );
+    assert.equal(after, 0, 'the slot is free again once the response has flushed');
+  });
+
+  it('still refuses a zero-byte Class P request and recovers on the next request', async () => {
+    // Revoke the binding: the refusal must be zero bytes, and it must not
+    // consume the connection slot for the request that follows.
+    const now = new Date().toISOString();
+    db.prepare("UPDATE local_principal_bindings SET status = 'REVOKED', revoked_at = ? WHERE binding_id = 'b-1'").run(now);
+    db.prepare("UPDATE local_principal_memberships SET status = 'REVOKED', revoked_at = ? WHERE membership_id = 'm-1'").run(now);
+
+    const refused = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    assert.equal(refused.byteLength, 0, 'the refusal is a zero-byte Class P response');
+
+    db.prepare("UPDATE local_principal_bindings SET status = 'ACTIVE', revoked_at = NULL WHERE binding_id = 'b-1'").run();
+    db.prepare("UPDATE local_principal_memberships SET status = 'ACTIVE', revoked_at = NULL WHERE membership_id = 'm-1'").run();
+
+    const recovered = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    assert.ok(recovered.byteLength > 0, 'the next request after a refusal succeeds');
+  });
+});
