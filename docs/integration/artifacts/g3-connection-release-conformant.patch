+/**
+ * Gate 3 — Migration 002: local, hash-chained audit event sequence (A-3).
+ *
+ * IMMUTABLE: checksummed into the migration ledger. The audit line is a local
+ * SHA-256 chain anchored at the 64-zero genesis; it has no cross-system sink
+ * and opens no socket.
+ */
+import type { Migration } from '../migration_ledger.js';
+
+export const migration002AuditEventSequence: Migration = {
+  id: '002_audit_event_sequence',
+  sql: `
+CREATE TABLE audit_events (
+    id              INTEGER PRIMARY KEY AUTOINCREMENT,
+    event_type      TEXT NOT NULL,
+    subject_type    TEXT NOT NULL,
+    subject_id      TEXT NOT NULL,
+    detail_json     TEXT NOT NULL,
+    prev_checksum   TEXT NOT NULL,
+    entry_checksum  TEXT NOT NULL,
+    created_at      TEXT NOT NULL
+);
+
+CREATE INDEX idx_audit_events_subject
+    ON audit_events (subject_type, subject_id, id);
+
+CREATE INDEX idx_audit_events_entry_checksum
+    ON audit_events (entry_checksum);
+`,
+};
diff --git a/src/persistence/migrations/003_local_principal_bindings.ts b/src/persistence/migrations/003_local_principal_bindings.ts
new file mode 100644
index 0000000..32b125b
--- /dev/null
+++ b/src/persistence/migrations/003_local_principal_bindings.ts
@@ -0,0 +1,43 @@
+/**
+ * Gate 3 — Migration 003: local principal bindings and memberships (A-2).
+ *
+ * IMMUTABLE: checksummed into the migration ledger. The partial-unique
+ * indexes enforce the single-ACTIVE rule at the storage layer: at most one
+ * ACTIVE binding and at most one ACTIVE membership may exist at any time,
+ * while any number of REVOKED rows are retained as history.
+ */
+import type { Migration } from '../migration_ledger.js';
+
+export const migration003LocalPrincipalBindings: Migration = {
+  id: '003_local_principal_bindings',
+  sql: `
+CREATE TABLE local_principal_bindings (
+    binding_id       TEXT PRIMARY KEY,
+    principal_label  TEXT NOT NULL,
+    status           TEXT NOT NULL CHECK (status IN ('ACTIVE', 'REVOKED')),
+    created_at       TEXT NOT NULL,
+    updated_at       TEXT NOT NULL,
+    revoked_at       TEXT
+);
+
+CREATE TABLE local_principal_memberships (
+    membership_id       TEXT PRIMARY KEY,
+    binding_id          TEXT NOT NULL REFERENCES local_principal_bindings(binding_id),
+    tenant_id           TEXT NOT NULL,
+    canonical_owner_id  TEXT NOT NULL,
+    status              TEXT NOT NULL CHECK (status IN ('ACTIVE', 'REVOKED')),
+    created_at          TEXT NOT NULL,
+    updated_at          TEXT NOT NULL,
+    revoked_at          TEXT
+);
+
+CREATE UNIQUE INDEX idx_local_principal_bindings_single_active
+    ON local_principal_bindings ((1)) WHERE status = 'ACTIVE';
+
+CREATE UNIQUE INDEX idx_local_principal_memberships_single_active
+    ON local_principal_memberships ((1)) WHERE status = 'ACTIVE';
+
+CREATE INDEX idx_local_principal_memberships_binding
+    ON local_principal_memberships (binding_id, status);
+`,
+};
diff --git a/src/persistence/portfolio_store.ts b/src/persistence/portfolio_store.ts
new file mode 100644
index 0000000..2ee9630
--- /dev/null
+++ b/src/persistence/portfolio_store.ts
@@ -0,0 +1,367 @@
+/**
+ * Gate 3 — owner-scoped durable portfolio store.
+ *
+ * The store implements the governed write semantics (immutable revision
+ * lifecycle 1 -> 2 -> 3 -> 4, optimistic-revision conflicts, content-hash
+ * idempotency and tombstone retention) behind an explicit authorization
+ * decision supplied by the caller. The IPC dispatcher never reaches a write
+ * while Gate E W-1 is unmet; the PortfolioStorePort evaluates that guard and
+ * refuses before touching the store. Reads are owner-scoped: a missing,
+ * foreign-owned or tombstoned portfolio share one ResourceUnavailableError so
+ * existence cannot be probed across owners.
+ */
+import { createHash } from 'node:crypto';
+import type { DatabaseSync } from 'node:sqlite';
+
+export class InvalidPortfolioRequestError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'InvalidPortfolioRequestError';
+  }
+}
+
+export class RevisionConflictError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'RevisionConflictError';
+  }
+}
+
+export class ResourceUnavailableError extends Error {
+  constructor(message = 'the requested resource is not available') {
+    super(message);
+    this.name = 'ResourceUnavailableError';
+  }
+}
+
+export class WriteNotAuthorizedError extends Error {
+  constructor(message = 'WRITE_NOT_AUTHORIZED') {
+    super(message);
+    this.name = 'WriteNotAuthorizedError';
+  }
+}
+
+export interface HoldingInput {
+  symbol: string;
+  companyId: string;
+  quantity: number;
+  averageBuyPrice: number;
+  currentPrice: number;
+  marketValue: number;
+  weightPercentage: number;
+  active: boolean;
+  sourceBroker: string;
+  lineageDigest: string;
+  identityStatus: string;
+  resolutionDisposition: string;
+}
+
+export interface PortfolioSaveRequest {
+  readonly name?: string;
+  readonly holdings: HoldingInput[];
+  readonly provenanceDigest: string;
+  readonly operation?: 'MERGE' | 'REPLACE';
+}
+
+export interface OwnerRef {
+  readonly canonicalOwnerId: string;
+  readonly tenantId: string;
+}
+
+/**
+ * Gate E W-1 conjunction. W-1(3) (Gate 4 qualification) and W-1(4) (Gate 5
+ * admission) are both false in this build, so the guard can never authorize.
+ * No environment flag, test result or operator assertion changes this.
+ */
+export function evaluatePortSaveGuard(): { authorized: boolean; reasons: string[] } {
+  return {
+    authorized: false,
+    reasons: ['W-1(3): Gate 4 qualification not accepted', 'W-1(4): Gate 5 admission not accepted'],
+  };
+}
+
+export function computeLineageHash(holdings: readonly HoldingInput[]): string {
+  const canonical = holdings
+    .map((h) => `${h.symbol}|${h.quantity}|${h.averageBuyPrice}|${h.lineageDigest}`)
+    .sort()
+    .join('\n');
+  return createHash('sha256').update(canonical, 'utf8').digest('hex');
+}
+
+const IDENTITY_KEY_PATTERN = /(owner|tenant|user|principal|membership|credential|password|secret|token|auth|claim|scope|role|identity|session)/i;
+
+/** C7 store-side scan: caller-supplied identity/authority keys are refused. */
+export function findCallerSuppliedIdentityKeys(value: unknown, depth = 0): string[] {
+  if (depth > 12 || value === null || typeof value !== 'object') return [];
+  if (Array.isArray(value)) {
+    return [...new Set(value.flatMap((item) => findCallerSuppliedIdentityKeys(item, depth + 1)))].sort();
+  }
+  const found = new Set<string>();
+  for (const [key, nested] of Object.entries(value as Record<string, unknown>)) {
+    if (IDENTITY_KEY_PATTERN.test(key)) found.add(key);
+    for (const inner of findCallerSuppliedIdentityKeys(nested, depth + 1)) found.add(inner);
+  }
+  return [...found].sort();
+}
+
+function contentDigestOf(request: PortfolioSaveRequest): string {
+  return createHash('sha256')
+    .update(JSON.stringify({ holdings: request.holdings, provenance: request.provenanceDigest }), 'utf8')
+    .digest('hex');
+}
+
+const MAX_REVISIONS = 4;
+
+export class DurablePortfolioStore {
+  constructor(private readonly db: DatabaseSync) {}
+
+  list(owner: OwnerRef): Array<{ portfolioId: string; name: string; currentRevision: number }> {
+    const rows = this.db
+      .prepare(
+        `SELECT portfolio_id, portfolio_name, current_revision
+           FROM portfolios
+          WHERE canonical_owner_id = ? AND tenant_id = ? AND status = 'ACTIVE'
+          ORDER BY portfolio_id`,
+      )
+      .all(owner.canonicalOwnerId, owner.tenantId) as unknown as Array<{
+      portfolio_id: string;
+      portfolio_name: string;
+      current_revision: number;
+    }>;
+    return rows.map((row) => ({
+      portfolioId: row.portfolio_id,
+      name: row.portfolio_name,
+      currentRevision: Number(row.current_revision),
+    }));
+  }
+
+  private resolvePortfolio(owner: OwnerRef, portfolioId: string): { currentRevision: number } {
+    const row = this.db
+      .prepare(
+        `SELECT current_revision, status FROM portfolios
+          WHERE canonical_owner_id = ? AND tenant_id = ? AND portfolio_id = ?`,
+      )
+      .get(owner.canonicalOwnerId, owner.tenantId, portfolioId) as
+      | { current_revision: number; status: string }
+      | undefined;
+    if (!row || row.status === 'TOMBSTONED') {
+      // Missing, foreign and tombstoned are deliberately indistinguishable.
+      throw new ResourceUnavailableError();
+    }
+    return { currentRevision: Number(row.current_revision) };
+  }
+
+  get(owner: OwnerRef, portfolioId: string): {
+    portfolioId: string;
+    revision: number;
+    holdings: HoldingInput[];
+  } {
+    const resolved = this.resolvePortfolio(owner, portfolioId);
+    const rows = this.db
+      .prepare(
+        `SELECT holding_key, symbol, company_id, quantity, average_buy_price, current_price,
+                market_value, weight_percentage, active, source_broker, lineage_digest,
+                identity_status, resolution_disposition
+           FROM portfolio_holdings
+          WHERE canonical_owner_id = ? AND portfolio_id = ? AND revision = ?
+          ORDER BY holding_key`,
+      )
+      .all(owner.canonicalOwnerId, portfolioId, resolved.currentRevision) as unknown as Array<Record<string, unknown>>;
+    return {
+      portfolioId,
+      revision: resolved.currentRevision,
+      holdings: rows.map((r) => this.holdingFromRow(r)),
+    };
+  }
+
+  revisions(owner: OwnerRef, portfolioId: string): Array<{ revision: number; operation: string; createdAt: string }> {
+    this.resolvePortfolio(owner, portfolioId);
+    const rows = this.db
+      .prepare(
+        `SELECT revision, operation, created_at FROM portfolio_revisions
+          WHERE canonical_owner_id = ? AND portfolio_id = ? ORDER BY revision`,
+      )
+      .all(owner.canonicalOwnerId, portfolioId) as unknown as Array<{
+      revision: number | bigint;
+      operation: string;
+      created_at: string;
+    }>;
+    return rows.map((row) => ({
+      revision: Number(row.revision),
+      operation: row.operation,
+      createdAt: row.created_at,
+    }));
+  }
+
+  private holdingFromRow(r: Record<string, unknown>): HoldingInput {
+    return {
+      symbol: String(r.symbol),
+      companyId: String(r.company_id),
+      quantity: Number(r.quantity),
+      averageBuyPrice: Number(r.average_buy_price),
+      currentPrice: Number(r.current_price),
+      marketValue: Number(r.market_value),
+      weightPercentage: Number(r.weight_percentage),
+      active: Number(r.active) === 1,
+      sourceBroker: String(r.source_broker),
+      lineageDigest: String(r.lineage_digest),
+      identityStatus: String(r.identity_status),
+      resolutionDisposition: String(r.resolution_disposition),
+    };
+  }
+
+  private validate(request: PortfolioSaveRequest): void {
+    if (!Array.isArray(request.holdings) || request.holdings.length === 0) {
+      throw new InvalidPortfolioRequestError('a portfolio revision requires at least one holding');
+    }
+    // The C7 scan covers the request envelope only. Holding rows legitimately
+    // carry domain identity fields (identityStatus, resolutionDisposition,
+    // companyId) that the wire envelope scanner would refuse; those fields are
+    // governed domain data inside the revision, not caller-supplied authority.
+    const { holdings: _holdings, ...envelopeShape } = request;
+    const refused = findCallerSuppliedIdentityKeys(envelopeShape);
+    if (refused.length > 0) {
+      throw new InvalidPortfolioRequestError(`caller-supplied identity keys are refused: ${refused.join(', ')}`);
+    }
+    const keys = new Set(request.holdings.map((h) => h.symbol));
+    if (keys.size !== request.holdings.length) {
+      throw new InvalidPortfolioRequestError('duplicate holding symbols in the request');
+    }
+  }
+
+  private writeRevision(
+    owner: OwnerRef,
+    portfolioId: string,
+    request: PortfolioSaveRequest,
+    operation: 'INITIAL' | 'MERGE' | 'REPLACE' | 'RESET' | 'DELETE',
+    expectedRevision: number,
+  ): number {
+    const current = this.resolvePortfolio(owner, portfolioId);
+    if (current.currentRevision !== expectedRevision) {
+      throw new RevisionConflictError(
+        `expected revision ${expectedRevision} but the portfolio is at ${current.currentRevision}`,
+      );
+    }
+    if (current.currentRevision >= MAX_REVISIONS && operation !== 'DELETE') {
+      throw new RevisionConflictError(`the immutable revision lifecycle is capped at ${MAX_REVISIONS}`);
+    }
+    const nextRevision = expectedRevision + 1;
+    const contentDigest = contentDigestOf(request);
+    const lastRevision = this.db
+      .prepare('SELECT content_digest FROM portfolio_revisions WHERE canonical_owner_id = ? AND portfolio_id = ? ORDER BY revision DESC LIMIT 1')
+      .get(owner.canonicalOwnerId, portfolioId) as { content_digest: string | null } | undefined;
+    if (lastRevision?.content_digest === contentDigest && operation !== 'DELETE') {
+      // Content-hash idempotency: no new revision, no new rows.
+      return expectedRevision;
+    }
+    const now = new Date().toISOString();
+    const totalMarketValue = request.holdings.reduce((sum, h) => sum + h.marketValue, 0);
+    const weightSum = request.holdings.reduce((sum, h) => sum + h.weightPercentage, 0);
+    this.db
+      .prepare(
+        `INSERT INTO portfolio_revisions
+           (portfolio_id, canonical_owner_id, revision, operation, total_market_value,
+            weight_sum_percentage, holdings_count, provenance_digest, content_digest, created_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      )
+      .run(
+        portfolioId,
+        owner.canonicalOwnerId,
+        nextRevision,
+        operation,
+        totalMarketValue,
+        weightSum,
+        request.holdings.length,
+        request.provenanceDigest,
+        contentDigest,
+        now,
+      );
+    const insertHolding = this.db.prepare(
+      `INSERT INTO portfolio_holdings
+         (canonical_owner_id, portfolio_id, revision, holding_key, symbol, company_id,
+          quantity, average_buy_price, current_price, market_value, weight_percentage,
+          active, source_broker, lineage_digest, identity_status, resolution_disposition, created_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    );
+    for (const h of request.holdings) {
+      insertHolding.run(
+        owner.canonicalOwnerId,
+        portfolioId,
+        nextRevision,
+        h.symbol,
+        h.symbol,
+        h.companyId,
+        h.quantity,
+        h.averageBuyPrice,
+        h.currentPrice,
+        h.marketValue,
+        h.weightPercentage,
+        h.active ? 1 : 0,
+        h.sourceBroker,
+        h.lineageDigest,
+        h.identityStatus,
+        h.resolutionDisposition,
+        now,
+      );
+    }
+    this.db
+      .prepare('UPDATE portfolios SET current_revision = ?, updated_at = ? WHERE canonical_owner_id = ? AND portfolio_id = ?')
+      .run(nextRevision, now, owner.canonicalOwnerId, portfolioId);
+    return nextRevision;
+  }
+
+  create(owner: OwnerRef, portfolioId: string, request: PortfolioSaveRequest): number {
+    this.validate(request);
+    const existing = this.db
+      .prepare('SELECT 1 FROM portfolios WHERE canonical_owner_id = ? AND portfolio_id = ?')
+      .get(owner.canonicalOwnerId, portfolioId);
+    if (existing) {
+      throw new InvalidPortfolioRequestError(`portfolio already exists: ${portfolioId}`);
+    }
+    const now = new Date().toISOString();
+    // Start at revision 0; the INITIAL revision write below moves it to 1
+    // through the same conflict-checked path as every later revision.
+    this.db
+      .prepare(
+        `INSERT INTO portfolios (portfolio_id, canonical_owner_id, tenant_id, portfolio_name,
+                                 current_revision, status, created_at, updated_at, deleted_at)
+         VALUES (?, ?, ?, ?, 0, 'ACTIVE', ?, ?, NULL)`,
+      )
+      .run(portfolioId, owner.canonicalOwnerId, owner.tenantId, request.name ?? portfolioId, now, now);
+    return this.writeRevision(owner, portfolioId, request, 'INITIAL', 0);
+  }
+
+  save(owner: OwnerRef, portfolioId: string, request: PortfolioSaveRequest, expectedRevision: number): number {
+    this.validate(request);
+    return this.writeRevision(owner, portfolioId, request, request.operation === 'REPLACE' ? 'REPLACE' : 'MERGE', expectedRevision);
+  }
+
+  reset(owner: OwnerRef, portfolioId: string, request: PortfolioSaveRequest, expectedRevision: number): number {
+    this.validate(request);
+    return this.writeRevision(owner, portfolioId, request, 'RESET', expectedRevision);
+  }
+
+  delete(owner: OwnerRef, portfolioId: string, expectedRevision: number): void {
+    const current = this.resolvePortfolio(owner, portfolioId);
+    if (current.currentRevision !== expectedRevision) {
+      throw new RevisionConflictError(
+        `expected revision ${expectedRevision} but the portfolio is at ${current.currentRevision}`,
+      );
+    }
+    const now = new Date().toISOString();
+    this.db
+      .prepare(
+        `INSERT INTO portfolio_revisions
+           (portfolio_id, canonical_owner_id, revision, operation, total_market_value,
+            weight_sum_percentage, holdings_count, provenance_digest, content_digest, created_at)
+         VALUES (?, ?, ?, 'DELETE', 0, 0, 0, ?, NULL, ?)`,
+      )
+      .run(portfolioId, owner.canonicalOwnerId, expectedRevision + 1, `tombstone:${portfolioId}`, now);
+    this.db
+      .prepare(
+        `UPDATE portfolios SET status = 'TOMBSTONED', deleted_at = ?, updated_at = ?
+          WHERE canonical_owner_id = ? AND portfolio_id = ?`,
+      )
+      .run(now, now, owner.canonicalOwnerId, portfolioId);
+  }
+}
diff --git a/src/persistence/provisioning.ts b/src/persistence/provisioning.ts
new file mode 100644
index 0000000..dc84418
--- /dev/null
+++ b/src/persistence/provisioning.ts
@@ -0,0 +1,113 @@
+/**
+ * Gate 3 — Gate A′ local-principal provisioning, library-only.
+ *
+ * Gate A′ is APPROVED / NOT EXECUTED. This module therefore exposes no
+ * executable entrypoint to the rest of the program: every mutating function
+ * requires a GateAPrimeAuthorization carrying a module-private symbol brand
+ * that no in-repository code can mint (a structural object literal cannot
+ * supply a symbol-keyed property it cannot name). The pure statement builder
+ * and the read-only inspector stay executable so the included code remains
+ * testable without opening a provisioning path.
+ *
+ * No IPC or startup module imports this file (static regression in
+ * g3_startup_validation): provisioning is unreachable from every IPC op.
+ */
+import { createHash } from 'node:crypto';
+import type { DatabaseSync } from 'node:sqlite';
+import { appendAuditEvent } from './audit.js';
+import { inspectBindings } from './binding.js';
+
+export class ProvisioningNotAuthorizedError extends Error {
+  constructor(message = 'Gate A′ provisioning is not authorized in this build') {
+    super(message);
+    this.name = 'ProvisioningNotAuthorizedError';
+  }
+}
+
+const GATE_A_PRIME_BRAND: unique symbol = Symbol('gate-a-prime-authorization');
+
+export interface GateAPrimeAuthorization {
+  readonly issuedAt: string;
+  readonly act: 'gate-a-prime';
+  readonly [GATE_A_PRIME_BRAND]: true;
+}
+
+export interface ProvisionBindingInput {
+  readonly principalLabel: string;
+  readonly tenantId: string;
+  readonly canonicalOwnerId: string;
+}
+
+export interface ProvisionStatements {
+  readonly bindingSql: string;
+  readonly membershipSql: string;
+}
+
+function isAuthorized(auth: unknown): auth is GateAPrimeAuthorization {
+  return (
+    typeof auth === 'object' &&
+    auth !== null &&
+    (auth as GateAPrimeAuthorization).act === 'gate-a-prime' &&
+    (auth as GateAPrimeAuthorization)[GATE_A_PRIME_BRAND] === true
+  );
+}
+
+/**
+ * Pure, side-effect-free SQL builder. Executable without authorization: it
+ * returns text and touches no database.
+ */
+export function buildBindingProvisionStatements(input: ProvisionBindingInput): ProvisionStatements {
+  const bindingId = createHash('sha256').update(`binding:${input.principalLabel}`, 'utf8').digest('hex').slice(0, 32);
+  const membershipId = createHash('sha256')
+    .update(`membership:${input.tenantId}:${input.canonicalOwnerId}`, 'utf8')
+    .digest('hex')
+    .slice(0, 32);
+  return {
+    bindingSql:
+      'INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) ' +
+      `VALUES ('${bindingId}', '${input.principalLabel}', 'ACTIVE', ?, ?, NULL)`,
+    membershipSql:
+      'INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) ' +
+      `VALUES ('${membershipId}', '${bindingId}', '${input.tenantId}', '${input.canonicalOwnerId}', 'ACTIVE', ?, ?, NULL)`,
+  };
+}
+
+export { inspectBindings };
+
+/**
+ * The single mutating entrypoint. Refuses before any SQL when the
+ * authorization is missing or forged; a successful call writes the binding
+ * and membership plus an audit line in one transaction.
+ */
+export function provisionActiveBinding(
+  db: DatabaseSync,
+  auth: unknown,
+  input: ProvisionBindingInput,
+): { bindingId: string; membershipId: string } {
+  if (!isAuthorized(auth)) {
+    throw new ProvisioningNotAuthorizedError();
+  }
+  const statements = buildBindingProvisionStatements(input);
+  const now = new Date().toISOString();
+  db.exec('BEGIN IMMEDIATE;');
+  try {
+    db.prepare(statements.bindingSql).run(now, now);
+    db.prepare(statements.membershipSql).run(now, now);
+    appendAuditEvent(db, {
+      eventType: 'local_principal_binding.provisioned',
+      subjectType: 'local_principal_binding',
+      subjectId: input.principalLabel,
+      detail: { tenantId: input.tenantId, canonicalOwnerId: input.canonicalOwnerId },
+    });
+    db.exec('COMMIT;');
+  } catch (error) {
+    db.exec('ROLLBACK;');
+    throw error;
+  }
+  const bindingId = createHash('sha256').update(`binding:${input.principalLabel}`, 'utf8').digest('hex').slice(0, 32);
+  const membershipId = createHash('sha256')
+    .update(`membership:${input.tenantId}:${input.canonicalOwnerId}`, 'utf8')
+    .digest('hex')
+    .slice(0, 32);
+  return { bindingId, membershipId };
+}
diff --git a/tests/g3_binding_resolution.test.ts b/tests/g3_binding_resolution.test.ts
new file mode 100644
index 0000000..c3e130a
--- /dev/null
+++ b/tests/g3_binding_resolution.test.ts
@@ -0,0 +1,300 @@
+/**
+ * Gate 3 T-B — per-request local principal binding resolution, host-adaptive.
+ *
+ * The active owner is resolved afresh on every request: no cache, no
+ * process-global owner, so a revocation takes effect on the next connection.
+ * Storage-level partial-unique indexes enforce the single-ACTIVE rule, and
+ * malformed binding shapes fail closed through the same Class P path.
+ */
+import { describe, it, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createConnection } from 'node:net';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { openDatabase, closeDatabase } from '../src/persistence/connection.js';
+import { ensureMigrations } from '../src/persistence/migration_ledger.js';
+import { GATE3_MIGRATIONS } from '../src/ipc/entrypoint.js';
+import {
+  listenIpc,
+  resolveEndpointTarget,
+  settlementPolicyForEndpoint,
+  type IpcHandle,
+} from '../src/ipc/endpoint.js';
+import { createConnectionHandler } from '../src/ipc/dispatch.js';
+import {
+  BindingAbsentError,
+  BindingInvalidError,
+  resolveActiveBinding,
+} from '../src/persistence/binding.js';
+import { verifyAuditChain } from '../src/persistence/audit.js';
+
+const HOST_PLATFORM: NodeJS.Platform = process.platform === 'win32' ? 'win32' : 'linux';
+const ENDPOINT_NAME = `iips-g3-binding-${process.pid}`;
+
+function frameFor(value: unknown): Buffer {
+  const body = Buffer.from(JSON.stringify(value), 'utf8');
+  const prefix = Buffer.allocUnsafe(4);
+  prefix.writeUInt32BE(body.byteLength, 0);
+  return Buffer.concat([prefix, body]);
+}
+
+function call(endpointPath: string, envelope: unknown): Promise<Buffer> {
+  return new Promise((resolve) => {
+    const socket = createConnection({ path: endpointPath });
+    const chunks: Buffer[] = [];
+    socket.on('data', (chunk) => chunks.push(chunk));
+    socket.on('error', () => resolve(Buffer.concat(chunks)));
+    socket.on('close', () => resolve(Buffer.concat(chunks)));
+    socket.on('connect', () => socket.write(frameFor(envelope), () => socket.end()));
+  });
+}
+
+describe('g3 / T-B binding resolution', () => {
+  let root: string;
+  let db: DatabaseSync;
+  let handle: IpcHandle;
+  let endpointPath: string;
+
+  before(async () => {
+    root = mkdtempSync(join(tmpdir(), 'g3-binding-'));
+    db = openDatabase(join(root, 'store', 'ipd.db'));
+    ensureMigrations(db, GATE3_MIGRATIONS);
+    const target = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: join(root, 'state') },
+      HOST_PLATFORM,
+    );
+    endpointPath = target.path;
+    handle = await listenIpc(
+      target,
+      createConnectionHandler(db, { settlement: settlementPolicyForEndpoint(target) }),
+      { platform: HOST_PLATFORM },
+    );
+  });
+
+  after(async () => {
+    await handle.stop();
+    closeDatabase();
+    rmSync(root, { recursive: true, force: true });
+  });
+
+  function seedActive(bindingId: string, membershipId: string, owner: string): void {
+    const now = new Date().toISOString();
+    db.prepare(
+      "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES (?, 'operator', 'ACTIVE', ?, ?, NULL)",
+    ).run(bindingId, now, now);
+    db.prepare(
+      "INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) VALUES (?, ?, 'tenant-local', ?, 'ACTIVE', ?, ?, NULL)",
+    ).run(membershipId, bindingId, owner, now, now);
+  }
+
+  function revoke(bindingId: string, membershipId: string): void {
+    const now = new Date().toISOString();
+    db.prepare("UPDATE local_principal_bindings SET status = 'REVOKED', revoked_at = ? WHERE binding_id = ?").run(now, bindingId);
+    db.prepare("UPDATE local_principal_memberships SET status = 'REVOKED', revoked_at = ? WHERE membership_id = ?").run(now, membershipId);
+  }
+
+  it('resolves the single ACTIVE binding and membership', () => {
+    seedActive('b-1', 'm-1', 'owner-local');
+    const owner = resolveActiveBinding(db);
+    assert.equal(owner.bindingId, 'b-1');
+    assert.equal(owner.membershipId, 'm-1');
+    assert.equal(owner.canonicalOwnerId, 'owner-local');
+    assert.equal(owner.tenantId, 'tenant-local');
+  });
+
+  it('the partial-unique index blocks a second ACTIVE binding', () => {
+    const now = new Date().toISOString();
+    assert.throws(() =>
+      db.prepare(
+        "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES ('b-x', 'other', 'ACTIVE', ?, ?, NULL)",
+      ).run(now, now),
+    );
+  });
+
+  it('the partial-unique index blocks a second ACTIVE membership', () => {
+    const now = new Date().toISOString();
+    assert.throws(() =>
+      db.prepare(
+        "INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) VALUES ('m-x', 'b-1', 't2', 'o2', 'ACTIVE', ?, ?, NULL)",
+      ).run(now, now),
+    );
+  });
+
+  it('an ACTIVE membership attached to a different binding is BindingInvalidError', () => {
+    const now = new Date().toISOString();
+    // The single-ACTIVE index means the existing membership must leave the
+    // ACTIVE set before the orphan can occupy it.
+    db.prepare("UPDATE local_principal_memberships SET status = 'REVOKED', revoked_at = ? WHERE membership_id = 'm-1'").run(now);
+    db.prepare(
+      "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES ('b-orphan', 'orphan', 'REVOKED', ?, ?, ?)",
+    ).run(now, now, now);
+    db.prepare(
+      "INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) VALUES ('m-orphan', 'b-orphan', 't', 'o-orphan', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+    assert.throws(() => resolveActiveBinding(db), BindingInvalidError);
+    db.prepare("DELETE FROM local_principal_memberships WHERE membership_id = 'm-orphan'").run();
+    db.prepare("DELETE FROM local_principal_bindings WHERE binding_id = 'b-orphan'").run();
+    db.prepare("UPDATE local_principal_memberships SET status = 'ACTIVE', revoked_at = NULL WHERE membership_id = 'm-1'").run();
+  });
+
+  it('revoking the only ACTIVE pair makes direct resolution throw BindingAbsentError', () => {
+    revoke('b-1', 'm-1');
+    assert.throws(() => resolveActiveBinding(db), BindingAbsentError);
+  });
+
+  it('re-resolves per request with no cache: a revocation takes effect on the next request', async () => {
+    seedActive('b-2', 'm-2', 'owner-two');
+    const envelope = { v: 1, op: 'portfolio.list' };
+    const first = await call(endpointPath, envelope);
+    assert.ok(first.byteLength > 0, 'the first request on a live binding receives a response');
+    const firstBody = JSON.parse(first.subarray(4).toString('utf8')) as Record<string, unknown>;
+    assert.equal(firstBody.ok, true);
+
+    revoke('b-2', 'm-2');
+
+    const second = await call(endpointPath, envelope);
+    assert.equal(second.byteLength, 0, 'the next request after revocation is a zero-byte Class P refusal');
+  });
+
+  it('an absent binding over IPC is zero-byte with no wire reason', async () => {
+    const response = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    assert.equal(response.byteLength, 0);
+  });
+
+  it('restoring an ACTIVE binding makes the next IPC request succeed again', async () => {
+    seedActive('b-3', 'm-3', 'owner-three');
+    const response = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    assert.ok(response.byteLength > 0);
+    const body = JSON.parse(response.subarray(4).toString('utf8')) as Record<string, unknown>;
+    assert.equal(body.ok, true);
+  });
+
+  it('multiple ACTIVE bindings after a restore still fail closed at the storage layer', () => {
+    const now = new Date().toISOString();
+    assert.throws(() =>
+      db.prepare(
+        "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES ('b-4', 'again', 'ACTIVE', ?, ?, NULL)",
+      ).run(now, now),
+    );
+  });
+
+  it('leaves a verifiable audit hash chain and no half-open transaction', () => {
+    assert.equal(verifyAuditChain(db), true);
+    db.exec('BEGIN IMMEDIATE;');
+    db.exec('ROLLBACK;');
+  });
+});
+
+/**
+ * Gate 3 T-C — connection release across sequential requests.
+ *
+ * Regression for the native-Windows zero-byte defect: with the flush-guard
+ * (Windows named-pipe) settlement policy the server wrote its single response
+ * without ever closing the handle. `listenIpc` sets `maxConnections = 1` (C5.4)
+ * and Node decrements `server._connections` only in `Socket._destroy`, so the
+ * one capacity slot stayed consumed for the server's lifetime and `net.js`
+ * dropped every later connection before emitting 'connection' — the peer saw
+ * zero bytes. The first request of a server lifetime succeeded and every
+ * subsequent one was silently refused, which is why the whole-file run failed
+ * while a name-filtered single test passed.
+ *
+ * The flush-guard policy is forced here so this regression also runs on POSIX,
+ * where the endpoint would otherwise select the AF_UNIX half-close policy whose
+ * `end()` happens to close the socket and mask the defect.
+ */
+describe('g3 / T-C connection release across sequential requests', () => {
+  let root: string;
+  let db: DatabaseSync;
+  let handle: IpcHandle;
+  let endpointPath: string;
+  let accepted = 0;
+  let closed = 0;
+
+  before(async () => {
+    root = mkdtempSync(join(tmpdir(), 'g3-release-'));
+    db = openDatabase(join(root, 'store', 'ipd.db'));
+    ensureMigrations(db, GATE3_MIGRATIONS);
+    const now = new Date().toISOString();
+    db.prepare(
+      "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES ('r-1', 'operator', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+    db.prepare(
+      "INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) VALUES ('rm-1', 'r-1', 'tenant-local', 'owner-local', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+
+    const target = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: `iips-g3-release-${process.pid}`, IIPS_G3_LOCAL_STATE_DIR: join(root, 'state') },
+      HOST_PLATFORM,
+    );
+    endpointPath = target.path;
+    handle = await listenIpc(
+      target,
+      createConnectionHandler(db, { settlement: 'flush-guard' }),
+      { platform: HOST_PLATFORM },
+    );
+    // Observe the server's own accounting: a connection is accepted, and its
+    // handle is closed exactly when the capacity slot is released.
+    handle.server.on('connection', (socket) => {
+      accepted += 1;
+      socket.once('close', () => {
+        closed += 1;
+      });
+    });
+  });
+
+  after(async () => {
+    await handle.stop();
+    closeDatabase();
+    rmSync(root, { recursive: true, force: true });
+  });
+
+  /** Wait for every accepted connection to be closed, bounded so a leak fails loudly. */
+  async function awaitAllReleased(deadlineMs = 5000): Promise<void> {
+    const started = Date.now();
+    while (closed < accepted && Date.now() - started < deadlineMs) {
+      await new Promise((resolve) => setTimeout(resolve, 5));
+    }
+    assert.equal(closed, accepted, `${accepted} accepted connection(s) must all be closed`);
+  }
+
+  it('serves every sequential request for the lifetime of one server', async () => {
+    const envelope = { v: 1, op: 'portfolio.list' };
+    for (let attempt = 1; attempt <= 5; attempt += 1) {
+      const response = await call(endpointPath, envelope);
+      assert.ok(
+        response.byteLength > 0,
+        `request ${attempt} received a response (an unreleased connection slot yields zero bytes)`,
+      );
+      const body = JSON.parse(response.subarray(4).toString('utf8')) as Record<string, unknown>;
+      assert.equal(body.ok, true, `request ${attempt} returned a success frame`);
+      assert.equal(body.op, 'portfolio.list');
+    }
+    assert.equal(accepted, 5, 'each request opened its own connection');
+  });
+
+  it('releases the single capacity slot once the response has flushed', async () => {
+    await awaitAllReleased();
+    const idle = await new Promise<number>((resolve) =>
+      handle.server.getConnections((error, count) => resolve(error ? -1 : count)),
+    );
+    assert.equal(idle, 0, 'no connection remains counted against the capacity of one');
+  });
+
+  it('recovers to a successful request after a zero-byte Class P refusal', async () => {
+    const now = new Date().toISOString();
+    db.prepare("UPDATE local_principal_bindings SET status = 'REVOKED', revoked_at = ? WHERE binding_id = 'r-1'").run(now);
+    db.prepare("UPDATE local_principal_memberships SET status = 'REVOKED', revoked_at = ? WHERE membership_id = 'rm-1'").run(now);
+
+    const refused = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    assert.equal(refused.byteLength, 0, 'the refusal is zero bytes');
+
+    db.prepare("UPDATE local_principal_bindings SET status = 'ACTIVE', revoked_at = NULL WHERE binding_id = 'r-1'").run();
+    db.prepare("UPDATE local_principal_memberships SET status = 'ACTIVE', revoked_at = NULL WHERE membership_id = 'rm-1'").run();
+
+    const recovered = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    assert.ok(recovered.byteLength > 0, 'the next request after a refusal succeeds');
+    await awaitAllReleased();
+  });
+});
diff --git a/tests/g3_caller_authority.test.ts b/tests/g3_caller_authority.test.ts
new file mode 100644
index 0000000..ef76ad7
--- /dev/null
+++ b/tests/g3_caller_authority.test.ts
@@ -0,0 +1,155 @@
+/**
+ * Gate 3 T-H — C7/OC-7 caller-authority refusal, host-adaptive.
+ *
+ * Every certified caller-identity/authority wire key is refused at any depth
+ * (top level, payload, nested options) before any store access: zero bytes,
+ * connection close and a bounded diagnostic-sink record. The closed envelope
+ * grammar and one valid control frame bound the data-driven refusal matrix.
+ */
+import { describe, it, before, after, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { createConnection } from 'node:net';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { openDatabase, closeDatabase } from '../src/persistence/connection.js';
+import { ensureMigrations } from '../src/persistence/migration_ledger.js';
+import { GATE3_MIGRATIONS } from '../src/ipc/entrypoint.js';
+import {
+  listenIpc,
+  resolveEndpointTarget,
+  settlementPolicyForEndpoint,
+  type IpcHandle,
+} from '../src/ipc/endpoint.js';
+import { createConnectionHandler } from '../src/ipc/dispatch.js';
+import {
+  diagnosticSink,
+  IPC_REFUSED_WIRE_KEYS,
+  IPC_RESERVED_OPERATIONS,
+} from '../src/ipc/protocol.js';
+
+const HOST_PLATFORM: NodeJS.Platform = process.platform === 'win32' ? 'win32' : 'linux';
+const ENDPOINT_NAME = `iips-g3-authority-${process.pid}`;
+const TABLES = [
+  'portfolios', 'portfolio_revisions', 'portfolio_holdings', 'portfolio_contributions',
+  'audit_events', 'local_principal_bindings', 'local_principal_memberships', '_migration_ledger',
+];
+
+function frameFor(value: unknown): Buffer {
+  const body = Buffer.from(JSON.stringify(value), 'utf8');
+  const prefix = Buffer.allocUnsafe(4);
+  prefix.writeUInt32BE(body.byteLength, 0);
+  return Buffer.concat([prefix, body]);
+}
+
+function call(endpointPath: string, envelope: unknown): Promise<Buffer> {
+  return new Promise((resolve) => {
+    const socket = createConnection({ path: endpointPath });
+    const chunks: Buffer[] = [];
+    socket.on('data', (chunk) => chunks.push(chunk));
+    socket.on('error', () => resolve(Buffer.concat(chunks)));
+    socket.on('close', () => resolve(Buffer.concat(chunks)));
+    socket.on('connect', () => socket.write(frameFor(envelope), () => socket.end()));
+  });
+}
+
+describe('g3 / T-H caller authority (C7) refusal matrix', () => {
+  let root: string;
+  let db: DatabaseSync;
+  let handle: IpcHandle;
+  let endpointPath: string;
+
+  function rowCounts(): Record<string, number> {
+    const counts: Record<string, number> = {};
+    for (const table of TABLES) {
+      const row = db.prepare(`SELECT COUNT(*) AS n FROM ${table}`).get() as { n: number | bigint };
+      counts[table] = Number(row.n);
+    }
+    return counts;
+  }
+
+  before(async () => {
+    root = mkdtempSync(join(tmpdir(), 'g3-authority-'));
+    db = openDatabase(join(root, 'store', 'ipd.db'));
+    ensureMigrations(db, GATE3_MIGRATIONS);
+    const now = new Date().toISOString();
+    db.prepare(
+      "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES ('b-1', 'operator', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+    db.prepare(
+      "INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) VALUES ('m-1', 'b-1', 'tenant-local', 'owner-local', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+
+    const target = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: join(root, 'state') },
+      HOST_PLATFORM,
+    );
+    endpointPath = target.path;
+    handle = await listenIpc(
+      target,
+      createConnectionHandler(db, { settlement: settlementPolicyForEndpoint(target) }),
+      { platform: HOST_PLATFORM },
+    );
+  });
+
+  after(async () => {
+    await handle.stop();
+    closeDatabase();
+    rmSync(root, { recursive: true, force: true });
+  });
+
+  beforeEach(() => {
+    diagnosticSink.drain();
+  });
+
+  for (const key of IPC_REFUSED_WIRE_KEYS) {
+    it(`refuses top-level caller authority key: ${key}`, async () => {
+      const response = await call(endpointPath, { v: 1, op: 'portfolio.list', [key]: 'spoofed' });
+      assert.equal(response.byteLength, 0);
+      assert.equal(diagnosticSink.peek().at(-1)?.reason, 'CALLER_SUPPLIED_AUTHORITY');
+    });
+  }
+
+  for (const key of IPC_REFUSED_WIRE_KEYS) {
+    it(`refuses caller authority key nested in payload: ${key}`, async () => {
+      const response = await call(endpointPath, {
+        v: 1,
+        op: 'portfolio.list',
+        payload: { [key]: 'spoofed' },
+      });
+      assert.equal(response.byteLength, 0);
+      assert.equal(diagnosticSink.peek().at(-1)?.reason, 'CALLER_SUPPLIED_AUTHORITY');
+    });
+  }
+
+  for (const key of IPC_REFUSED_WIRE_KEYS) {
+    it(`refuses caller authority key nested in payload.options: ${key}`, async () => {
+      const response = await call(endpointPath, {
+        v: 1,
+        op: 'portfolio.list',
+        payload: { options: { [key]: 'spoofed' } },
+      });
+      assert.equal(response.byteLength, 0);
+      assert.equal(diagnosticSink.peek().at(-1)?.reason, 'CALLER_SUPPLIED_AUTHORITY');
+    });
+  }
+
+  it('the full refusal matrix creates no rows and a clean control frame still succeeds', async () => {
+    const counts = rowCounts();
+    const response = await call(endpointPath, {
+      v: 1,
+      op: 'portfolio.list',
+      payload: { filter: 'open' },
+      requestId: 'control-1',
+    });
+    assert.ok(response.byteLength > 4);
+    const declared = response.readUInt32BE(0);
+    assert.equal(declared, response.byteLength - 4);
+    const body = JSON.parse(response.subarray(4).toString('utf8')) as Record<string, unknown>;
+    assert.equal(body.ok, true);
+    assert.equal(body.requestId, 'control-1');
+    assert.deepEqual(rowCounts(), counts, 'refusals and reads never mutate the store');
+    assert.equal(IPC_RESERVED_OPERATIONS.includes('portfolio.analytics'), true);
+  });
+});
