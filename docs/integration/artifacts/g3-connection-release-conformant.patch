+  it('refuses a second frame emitted immediately after frame 1, zero bytes', async () => {
+    const socket = new FakeSocket();
+    createConnectionHandler(db, { settlement: 'flush-guard', idleTimeoutMs: 2000 })(
+      socket as unknown as Socket,
+    );
+    socket.emit('data', listFrame);
+    socket.emit('data', secondFrame);
+    await drainTicks(4);
+
+    assert.equal(socket.written.length, 0);
+    assert.equal(socket.destroyed, true);
+    assert.equal(diagnosticSink.peek().at(-1)?.reason, 'MALFORMED_FRAME');
+  });
+
+  it('a transport error before the response flush yields zero bytes and no throw', async () => {
+    const socket = new FakeSocket(3);
+    socket.on('error', () => undefined);
+    createConnectionHandler(db, { settlement: 'flush-guard', idleTimeoutMs: 2000 })(
+      socket as unknown as Socket,
+    );
+    socket.emit('data', listFrame);
+    setImmediate(() =>
+      socket.emit('error', Object.assign(new Error('ECONNRESET'), { code: 'ECONNRESET' })),
+    );
+    try {
+      await drainTicks(8);
+    } catch {
+      assert.fail('the transport error must not throw out of the handler');
+    }
+    assert.equal(socket.written.length, 0);
+    assert.equal(socket.destroyed, true);
+  });
+
+  it('the broken-pipe EOF after a successful flush is harmless and leaves no reader listeners', async () => {
+    const socket = new FakeSocket();
+    createConnectionHandler(db, { settlement: 'flush-guard', idleTimeoutMs: 2000 })(
+      socket as unknown as Socket,
+    );
+    socket.emit('data', listFrame);
+    await drainTicks(2);
+    assert.equal(socket.written.length, 1);
+    socket.forceBrokenPipeEof();
+    await drainTicks(2);
+    assert.equal(socket.written.length, 1, 'the committed response is not retracted or duplicated');
+    assert.equal(socket.listenerCount('data'), 0);
+    assert.equal(socket.listenerCount('end'), 0);
+    assert.equal(socket.listenerCount('error'), 1, 'the dispatcher error handler remains owner-attached');
+  });
+
+  // Round-4 defect regression (Windows-transport emulation, not native evidence):
+  // a connection handler constructed without the transport-derived settlement
+  // policy defaults to half-close-required and therefore withholds its response
+  // until the only EOF a Windows byte-mode pipe ever delivers — the 50 ms
+  // forced break, when writes fail. The peer receives zero bytes. This is the
+  // exact mechanism behind the native-Windows empty-response failures.
+  it('a default-policy handler withholds every response byte on the Windows pipe timeline', async () => {
+    const socket = new FakeSocket();
+    createConnectionHandler(db, { idleTimeoutMs: 2000 })(socket as unknown as Socket);
+    socket.emit('data', listFrame);
+    setImmediate(() => socket.forceBrokenPipeEof());
+    await drainTicks(6);
+
+    assert.equal(socket.written.length, 0, 'the half-close gate never opens on a Windows pipe');
+    assert.equal(socket.destroyed, true, 'the failed response write fails closed with a teardown');
+    assert.equal(diagnosticSink.peek().at(-1)?.reason, 'MALFORMED_FRAME');
+  });
+
+  // Companion regression: deriving the policy from the actual endpoint target
+  // (as startIpcServer does, and as every direct handler construction must)
+  // selects flush-guard for a named pipe and the response is delivered in full
+  // before the forced break.
+  it('an endpoint-derived flush-guard handler delivers the full response on the same timeline', async () => {
+    const pipeTarget = resolveEndpointTarget(
+      { [IPC_ENDPOINT_SETTING]: '\\\\.\\pipe\\g3-round4-emulation' },
+      'win32',
+    );
+    const socketTarget = resolveEndpointTarget(
+      { [IPC_ENDPOINT_SETTING]: '/tmp/g3-round4-emulation.sock' },
+      'linux',
+    );
+    assert.equal(settlementPolicyForEndpoint(pipeTarget), 'flush-guard');
+    assert.equal(settlementPolicyForEndpoint(socketTarget), 'half-close-required');
+
+    const socket = new FakeSocket();
+    createConnectionHandler(db, {
+      settlement: settlementPolicyForEndpoint(pipeTarget),
+      idleTimeoutMs: 2000,
+    })(socket as unknown as Socket);
+    socket.emit('data', listFrame);
+    setImmediate(() => socket.forceBrokenPipeEof());
+    await drainTicks(6);
+
+    assert.equal(socket.written.length, 1, 'exactly one response frame reaches the peer');
+    const body = JSON.parse(socket.written[0].subarray(4).toString('utf8')) as Record<string, unknown>;
+    assert.equal(body.ok, true);
+    assert.equal(body.op, 'portfolio.list');
+  });
+
+  // §E boundary (Windows-transport emulation, not native evidence): frame 2 is
+  // delivered in a separate data event only AFTER the response has flushed.
+  //
+  // Contract position (act §4.2 item 11 "one request and at most one response
+  // per connection; pipelined frames refused"; §4.3 T-A "zero bytes; connection
+  // closed"): the refusal duty attaches to a frame the server can still observe.
+  // Here the response has already been legitimately delivered and the handle is
+  // closed, so the one-frame invariant is enforced structurally — frame 2 cannot
+  // reach the server, is never dispatched, and produces no second response.
+  // Zero-byte refusal is not applicable (a valid response was already sent) and
+  // no post-flush sink record is possible; the deterministic pre-flush refusals
+  // above remain the diagnostic coverage for T-A.
+  it('a post-flush second frame cannot reach the closed handle and is never dispatched', async () => {
+    const socket = new FakeSocket();
+    createConnectionHandler(db, { settlement: 'flush-guard', idleTimeoutMs: 2000 })(
+      socket as unknown as Socket,
+    );
+    socket.emit('data', listFrame);
+    await drainTicks(2);
+    assert.equal(socket.written.length, 1, 'the frame-1 response has already flushed');
+    assert.equal(socket.destroyed, true, 'the handle is closed as soon as the response has flushed');
+
+    socket.emit('data', secondFrame);
+    await drainTicks(4);
+
+    assert.equal(socket.written.length, 1, 'the second frame is never dispatched or answered');
+    const firstBody = JSON.parse(socket.written[0].subarray(4).toString('utf8')) as Record<string, unknown>;
+    assert.equal(firstBody.op, 'portfolio.list');
+
+    socket.forceBrokenPipeEof();
+    await drainTicks(2);
+    assert.equal(socket.listenerCount('data'), 0);
+    assert.equal(socket.listenerCount('end'), 0);
+    assert.equal(socket.listenerCount('error'), 1, 'only the caller-owned error handler remains');
+  });
+
+  it('releases the handle after a clean single-frame exchange and records nothing', async () => {
+    const socket = new FakeSocket();
+    createConnectionHandler(db, { settlement: 'flush-guard', idleTimeoutMs: 2000 })(
+      socket as unknown as Socket,
+    );
+    socket.emit('data', listFrame);
+    await drainTicks(2);
+    assert.equal(socket.written.length, 1);
+    assert.equal(
+      socket.destroyed,
+      true,
+      'a well-behaved single-frame peer is released, which frees the connection slot',
+    );
+
+    socket.forceBrokenPipeEof();
+    await drainTicks(2);
+    assert.equal(socket.written.length, 1, 'the single response is never duplicated');
+    assert.equal(diagnosticSink.peek().length, 0, 'a clean single-frame exchange records nothing');
+  });
+});
diff --git a/tests/g3_no_network_listener.test.ts b/tests/g3_no_network_listener.test.ts
new file mode 100644
index 0000000..b1e48c7
--- /dev/null
+++ b/tests/g3_no_network_listener.test.ts
@@ -0,0 +1,213 @@
+/**
+ * Gate 3 T-F — no TCP / HTTP / URL listener, and honest platform endpoints.
+ *
+ * Host-adaptive: the live endpoint is an AF_UNIX socket on POSIX and a named
+ * pipe under \\.\pipe on native Windows. Platform-independent invariants run on
+ * both hosts (string-only address, zero bytes for an HTTP request line and for
+ * a second simultaneous connection, no numeric listen, no readableAll/writableAll,
+ * resolver refusals). POSIX-only mode/uid checks run only on POSIX; Windows gets
+ * named-pipe namespace and descriptor checks instead, with no fabricated DACL
+ * claim.
+ */
+import { describe, it, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createConnection, type Socket } from 'node:net';
+import { existsSync, mkdtempSync, rmSync, readFileSync, statSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  isWindowsPipeNamespaceOnly,
+  listenIpc,
+  resolveEndpointTarget,
+  windowsPipeDescriptor,
+  type IpcHandle,
+} from '../src/ipc/endpoint.js';
+import { readSingleFrame, ClassPError, diagnosticSink } from '../src/ipc/protocol.js';
+
+const HOST_PLATFORM: NodeJS.Platform = process.platform === 'win32' ? 'win32' : 'linux';
+const IS_WINDOWS_HOST = HOST_PLATFORM === 'win32';
+const ENDPOINT_NAME = `iips-g3-nonet-${process.pid}`;
+const posixOnly = IS_WINDOWS_HOST ? it.skip : it;
+const windowsOnly = IS_WINDOWS_HOST ? it : it.skip;
+
+function stripComments(source: string): string {
+  return source
+    .replace(/\/\*[\s\S]*?\*\//g, '')
+    .replace(/(^|[^:])\/\/[^\n]*/g, '$1');
+}
+
+function connectOnce(socketPath: string, payload?: Buffer, waitMs = 0): Promise<Buffer> {
+  return new Promise((resolve) => {
+    const socket = createConnection({ path: socketPath });
+    const chunks: Buffer[] = [];
+    socket.on('data', (chunk) => chunks.push(chunk));
+    socket.on('error', () => resolve(Buffer.concat(chunks)));
+    socket.on('close', () => resolve(Buffer.concat(chunks)));
+    socket.on('connect', () => {
+      if (waitMs > 0) setTimeout(() => socket.end(), waitMs);
+      else if (payload) socket.write(payload, () => socket.end());
+      else socket.end();
+    });
+  });
+}
+
+describe('g3 / T-F no network listener and platform endpoint honesty', () => {
+  let root: string;
+  let stateDir: string;
+  let handle: IpcHandle;
+  let endpointPath: string;
+
+  before(async () => {
+    root = mkdtempSync(join(tmpdir(), 'g3-nonet-'));
+    stateDir = join(root, 'state');
+    const target = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: stateDir },
+      HOST_PLATFORM,
+    );
+    endpointPath = target.path;
+    const settlement = target.kind === 'windows-named-pipe' ? 'flush-guard' : 'half-close-required';
+    handle = await listenIpc(
+      target,
+      (socket: Socket) => {
+        socket.on('error', () => socket.destroy());
+        readSingleFrame(socket, { idleTimeoutMs: 2000, settlement })
+          .then(async (reader) => {
+            try {
+              if (reader.settlement === 'half-close-required') {
+                await reader.whenSettled;
+              }
+              socket.end();
+            } finally {
+              reader.release();
+            }
+          })
+          .catch((error: unknown) => {
+            if (error instanceof ClassPError) diagnosticSink.record(error.reason, error.message);
+            socket.destroy();
+          });
+      },
+      { platform: HOST_PLATFORM },
+    );
+  });
+
+  after(async () => {
+    await handle.stop();
+    rmSync(root, { recursive: true, force: true });
+  });
+
+  it('the live server address is a string path, never a {address, port} object', () => {
+    const address = handle.server.address();
+    assert.equal(typeof address, 'string');
+    assert.equal(address, endpointPath);
+  });
+
+  it('an HTTP request line receives zero bytes (the endpoint is not an HTTP server)', async () => {
+    const response = await connectOnce(endpointPath, Buffer.from('GET / HTTP/1.1\r\nHost: localhost\r\n\r\n', 'utf8'));
+    assert.equal(response.byteLength, 0);
+  });
+
+  it('a second simultaneous connection is capacity-capped and receives zero bytes (C5.4)', async () => {
+    const first = await new Promise<Buffer>((resolve) => {
+      const socket = createConnection({ path: endpointPath });
+      const chunks: Buffer[] = [];
+      socket.on('data', (chunk) => chunks.push(chunk));
+      socket.on('error', () => resolve(Buffer.concat(chunks)));
+      socket.on('close', () => resolve(Buffer.concat(chunks)));
+      socket.on('connect', () => {
+        createConnection({ path: endpointPath })
+          .on('data', () => undefined)
+          .on('error', () => undefined)
+          .on('close', () => socket.end());
+      });
+    });
+    assert.equal(first.byteLength, 0);
+  });
+
+  posixOnly('the POSIX state directory is owner-only 0700', () => {
+    const stat = statSync(stateDir);
+    assert.ok(stat.isDirectory());
+    assert.equal(stat.mode & 0o777, 0o700);
+    if (typeof process.getuid === 'function') assert.equal(stat.uid, process.getuid());
+  });
+
+  posixOnly('the POSIX socket itself is mode 0600 and owner-owned', () => {
+    const stat = statSync(endpointPath);
+    assert.ok(stat.isSocket());
+    assert.equal(stat.mode & 0o777, 0o600);
+    if (typeof process.getuid === 'function') assert.equal(stat.uid, process.getuid());
+  });
+
+  windowsOnly('the Windows endpoint is a named pipe with no filesystem artifact', () => {
+    // The invariant has three parts. A live pipe name can answer generic
+    // existence probes (the pipe namespace is stat-able), so existsSync on the
+    // pipe path is not a filesystem check and must not be used here.
+    assert.equal(handle.target.kind, 'windows-named-pipe');
+    assert.ok(isWindowsPipeNamespaceOnly(handle.target), 'the path stays inside the \\\\.\\pipe namespace');
+    assert.match(endpointPath, /^\\\\\.\\pipe\\/);
+    assert.ok(!existsSync(stateDir), 'a named-pipe bind creates no filesystem state directory');
+    assert.ok(!existsSync(join(stateDir, `${ENDPOINT_NAME}.sock`)), 'no POSIX-style socket file is created');
+    const address = handle.server.address();
+    assert.equal(typeof address, 'string');
+    assert.match(address as string, /^\\\\\.\\pipe\\/);
+  });
+
+  it('endpoint.ts never passes readableAll/writableAll and never calls listen with a numeric port', () => {
+    const here = fileURLToPath(new URL('.', import.meta.url));
+    const source = stripComments(readFileSync(join(here, '..', '..', 'src', 'ipc', 'endpoint.ts'), 'utf8'));
+    assert.ok(!/readableAll\s*:/.test(source), 'no readableAll option');
+    assert.ok(!/writableAll\s*:/.test(source), 'no writableAll option');
+    assert.ok(!/\.listen\(\s*\d/.test(source), 'no numeric listen argument (no TCP port)');
+    assert.ok(!/createServer\(\s*['"]http/.test(source), 'no HTTP server');
+  });
+
+  it('resolves a bare name with platform-matched absolute-path semantics (pure, no filesystem)', () => {
+    const posix = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: '/var/local/iips' },
+      'linux',
+    );
+    assert.equal(posix.kind, 'unix-socket');
+    assert.equal(posix.path, `/var/local/iips/${ENDPOINT_NAME}.sock`);
+    const win = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: 'C:\\iips\\state' },
+      'win32',
+    );
+    assert.equal(win.kind, 'windows-named-pipe');
+    assert.equal(win.path, `\\\\.\\pipe\\${ENDPOINT_NAME}`);
+  });
+
+  it('an explicit Windows pipe path is accepted; other absolute Windows paths are refused', () => {
+    const accepted = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: '\\\\.\\pipe\\iips-ipd-user-portfolio-v1' },
+      'win32',
+    );
+    assert.equal(accepted.path, '\\\\.\\pipe\\iips-ipd-user-portfolio-v1');
+    assert.throws(() => resolveEndpointTarget({ IIPS_G2_IPC_ENDPOINT: 'C:\\iips\\socket' }, 'win32'));
+  });
+
+  it('URLs, host:port pairs and relative paths are refused on both simulated platforms', () => {
+    for (const platform of ['linux', 'win32'] as const) {
+      assert.throws(() => resolveEndpointTarget({ IIPS_G2_IPC_ENDPOINT: 'tcp://127.0.0.1:9000' }, platform));
+      assert.throws(() => resolveEndpointTarget({ IIPS_G2_IPC_ENDPOINT: 'localhost:9000' }, platform));
+      assert.throws(
+        () => resolveEndpointTarget(
+          { IIPS_G2_IPC_ENDPOINT: 'relative/path.sock', IIPS_G3_LOCAL_STATE_DIR: platform === 'win32' ? 'C:\\x' : '/tmp/x' },
+          platform,
+        ),
+      );
+    }
+  });
+
+  it('the Windows descriptor claims no application-enforced DACL and names the Gate 4 items', () => {
+    const target = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: 'C:\\iips\\state' },
+      'win32',
+    );
+    const descriptor = windowsPipeDescriptor(target);
+    assert.equal(descriptor.enforcedByApplication, false);
+    assert.match(descriptor.platformDefault, /default DACL/);
+    assert.ok(descriptor.notVerifiableHere.includes('effective DACL/SDDL contents'));
+    assert.ok(descriptor.gate4EvidenceItems.includes('V-1'));
+    assert.ok(descriptor.applicationControls.some((line) => line.includes('no TCP')));
+  });
+});
diff --git a/tests/g3_portfolio_read_isolation.test.ts b/tests/g3_portfolio_read_isolation.test.ts
new file mode 100644
index 0000000..7b97862
--- /dev/null
+++ b/tests/g3_portfolio_read_isolation.test.ts
@@ -0,0 +1,184 @@
+/**
+ * Gate 3 T-C — owner-scoped portfolio read isolation, host-adaptive.
+ *
+ * Missing, foreign-owned and tombstoned portfolios are deliberately
+ * indistinguishable on the wire: the same RESOURCE_UNAVAILABLE Class A frame
+ * bytes for all three, so existence cannot be probed across owners. Reads are
+ * sequential over the single permitted connection, and the reserved
+ * portfolio.analytics operation stays outside the closed v1 set.
+ */
+import { describe, it, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createConnection } from 'node:net';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { openDatabase, closeDatabase } from '../src/persistence/connection.js';
+import { ensureMigrations } from '../src/persistence/migration_ledger.js';
+import { GATE3_MIGRATIONS } from '../src/ipc/entrypoint.js';
+import {
+  listenIpc,
+  resolveEndpointTarget,
+  settlementPolicyForEndpoint,
+  type IpcHandle,
+} from '../src/ipc/endpoint.js';
+import { createConnectionHandler } from '../src/ipc/dispatch.js';
+import { DurablePortfolioStore, type HoldingInput, type OwnerRef } from '../src/persistence/portfolio_store.js';
+
+const HOST_PLATFORM: NodeJS.Platform = process.platform === 'win32' ? 'win32' : 'linux';
+const ENDPOINT_NAME = `iips-g3-isolation-${process.pid}`;
+
+function frameFor(value: unknown): Buffer {
+  const body = Buffer.from(JSON.stringify(value), 'utf8');
+  const prefix = Buffer.allocUnsafe(4);
+  prefix.writeUInt32BE(body.byteLength, 0);
+  return Buffer.concat([prefix, body]);
+}
+
+function call(endpointPath: string, envelope: unknown): Promise<Buffer> {
+  return new Promise((resolve) => {
+    const socket = createConnection({ path: endpointPath });
+    const chunks: Buffer[] = [];
+    socket.on('data', (chunk) => chunks.push(chunk));
+    socket.on('error', () => resolve(Buffer.concat(chunks)));
+    socket.on('close', () => resolve(Buffer.concat(chunks)));
+    socket.on('connect', () => socket.write(frameFor(envelope), () => socket.end()));
+  });
+}
+
+function parseResponse(buffer: Buffer): Record<string, unknown> {
+  const declared = buffer.readUInt32BE(0);
+  return JSON.parse(buffer.subarray(4, 4 + declared).toString('utf8')) as Record<string, unknown>;
+}
+
+function holding(symbol: string): HoldingInput {
+  return {
+    symbol,
+    companyId: `C-${symbol}`,
+    quantity: 1,
+    averageBuyPrice: 100,
+    currentPrice: 100,
+    marketValue: 100,
+    weightPercentage: 100,
+    active: true,
+    sourceBroker: 'GENERIC',
+    lineageDigest: `lineage-${symbol}`,
+    identityStatus: 'RESOLVED',
+    resolutionDisposition: 'CANONICAL_P04',
+  };
+}
+
+describe('g3 / T-C portfolio read isolation', () => {
+  let root: string;
+  let db: DatabaseSync;
+  let handle: IpcHandle;
+  let endpointPath: string;
+  const local: OwnerRef = { canonicalOwnerId: 'owner-local', tenantId: 'tenant-local' };
+  const other: OwnerRef = { canonicalOwnerId: 'owner-other', tenantId: 'tenant-other' };
+
+  before(async () => {
+    root = mkdtempSync(join(tmpdir(), 'g3-isolation-'));
+    db = openDatabase(join(root, 'store', 'ipd.db'));
+    ensureMigrations(db, GATE3_MIGRATIONS);
+    const now = new Date().toISOString();
+    db.prepare(
+      "INSERT INTO local_principal_bindings (binding_id, principal_label, status, created_at, updated_at, revoked_at) VALUES ('b-1', 'operator', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+    db.prepare(
+      "INSERT INTO local_principal_memberships (membership_id, binding_id, tenant_id, canonical_owner_id, status, created_at, updated_at, revoked_at) VALUES ('m-1', 'b-1', 'tenant-local', 'owner-local', 'ACTIVE', ?, ?, NULL)",
+    ).run(now, now);
+
+    const store = new DurablePortfolioStore(db);
+    const request = { holdings: [holding('AAPL')], provenanceDigest: 'prov-iso' };
+    store.create(local, 'P-LOCAL', request);
+    store.create(other, 'P-FOREIGN', request);
+    const tombRevision = store.create(local, 'P-TOMB', request);
+    store.delete(local, 'P-TOMB', tombRevision);
+
+    const target = resolveEndpointTarget(
+      { IIPS_G2_IPC_ENDPOINT: ENDPOINT_NAME, IIPS_G3_LOCAL_STATE_DIR: join(root, 'state') },
+      HOST_PLATFORM,
+    );
+    endpointPath = target.path;
+    handle = await listenIpc(
+      target,
+      createConnectionHandler(db, { settlement: settlementPolicyForEndpoint(target) }),
+      { platform: HOST_PLATFORM },
+    );
+  });
+
+  after(async () => {
+    await handle.stop();
+    closeDatabase();
+    rmSync(root, { recursive: true, force: true });
+  });
+
+  it('a valid list returns only the resolved owner portfolios', async () => {
+    const response = parseResponse(await call(endpointPath, { v: 1, op: 'portfolio.list' }));
+    assert.equal(response.ok, true);
+    const portfolios = (response.result as { portfolios: Array<{ portfolioId: string }> }).portfolios;
+    const ids = portfolios.map((p) => p.portfolioId).sort();
+    assert.deepEqual(ids, ['P-LOCAL']);
+  });
+
+  it('a missing portfolio returns RESOURCE_UNAVAILABLE', async () => {
+    const response = parseResponse(
+      await call(endpointPath, { v: 1, op: 'portfolio.get', payload: { portfolioId: 'P-MISSING' } }),
+    );
+    assert.equal(response.ok, false);
+    assert.equal(response.outcome, 'RESOURCE_UNAVAILABLE');
+  });
+
+  it('a foreign-owned portfolio is byte-identical to the missing-portfolio response', async () => {
+    const missing = await call(endpointPath, {
+      v: 1,
+      op: 'portfolio.get',
+      payload: { portfolioId: 'P-MISSING' },
+      requestId: 'same-request-id',
+    });
+    const foreign = await call(endpointPath, {
+      v: 1,
+      op: 'portfolio.get',
+      payload: { portfolioId: 'P-FOREIGN' },
+      requestId: 'same-request-id',
+    });
+    assert.ok(foreign.equals(missing), 'missing and foreign frames must be byte-identical');
+    assert.equal(parseResponse(foreign).outcome, 'RESOURCE_UNAVAILABLE');
+  });
+
+  it('a tombstoned portfolio is byte-identical to the missing-portfolio response', async () => {
+    const missing = await call(endpointPath, {
+      v: 1,
+      op: 'portfolio.get',
+      payload: { portfolioId: 'P-MISSING' },
+      requestId: 'same-request-id',
+    });
+    const tombstoned = await call(endpointPath, {
+      v: 1,
+      op: 'portfolio.get',
+      payload: { portfolioId: 'P-TOMB' },
+      requestId: 'same-request-id',
+    });
+    assert.ok(tombstoned.equals(missing), 'tombstoned and missing frames must be byte-identical');
+  });
+
+  it('the reserved portfolio.analytics operation is refused with zero bytes', async () => {
+    const response = await call(endpointPath, { v: 1, op: 'portfolio.analytics' });
+    assert.equal(response.byteLength, 0);
+  });
+
+  it('sequential requests over separate connections each complete under the capacity cap', async () => {
+    const first = await call(endpointPath, { v: 1, op: 'portfolio.list' });
+    const second = await call(endpointPath, {
+      v: 1,
+      op: 'portfolio.revisions',
+      payload: { portfolioId: 'P-LOCAL' },
+    });
+    assert.ok(first.byteLength > 0);
+    assert.ok(second.byteLength > 0);
+    const revisions = parseResponse(second);
+    assert.equal(revisions.ok, true);
+    assert.equal((revisions.result as { revisions: unknown[] }).revisions.length, 1);
+  });
+});
