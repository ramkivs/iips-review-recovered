{
  "name": "@iips/v3-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Program v3.0 Enterprise Investment Intelligence Experience — React/TS/Vite application shell (Phase 3). Presentation-only; consumes certified v2.0 contracts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report.json",
    "server:dev": "tsx server/executive-transport.ts",
    "iid:readiness": "tsx server/investment/cli/iid-readiness.ts",
    "typecheck:replay-server": "tsc -p tsconfig.replay-server.json --noEmit",
    "typecheck:investment-server": "tsc -p tsconfig.investment-server.json --noEmit",
    "build:broker-import": "node scripts/materialize-broker-import.mjs && tsc -p tsconfig.broker-import.json",
    "predev": "npm run build:broker-import",
    "prebuild": "npm run build:broker-import",
    "pretest": "npm run build:broker-import",
    "pretest:ci": "npm run build:broker-import",
    "pretypecheck": "npm run build:broker-import"
  },
  "dependencies": {
    "iips-broker-import": "github:ramkivs/iips-production-market-data#58fc8fb7f033650f40d61078d70e951f21dd033f",
    "iips-np04-governed-persistence": "github:ramkivs/iips-production-market-data#2e11fa3b689d1a3674a5e4ba1f1de9a559e20494",
    "iips-production-market-data": "github:ramkivs/iips-production-market-data#59fdfd157632dbdbc220ae03d9d0b8e047d4ef19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
