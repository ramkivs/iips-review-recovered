{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": false,
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "server/executive-transport.ts",
    "server/screener/screener-transport.ts",
    "server/product-transport.test.ts",
    "server/screener/screener-transport.test.ts",
    "server/replay/**/*.ts",
    "server/replay/**/*.tsx"
  ]
}
