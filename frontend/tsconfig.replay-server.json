{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": false,
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "server/executive-transport.ts",
    "server/reports/persist-real-reports.ts",
    "server/reports/real-report-persistence.test.ts",
    "server/screener/screener-transport.ts",
    "server/product-transport.test.ts",
    "server/screener/screener-transport.test.ts",
    "server/replay/**/*.ts",
    "server/replay/**/*.tsx",
    "server/broker-import/step9AcceptanceFixtureOperator.ts",
    "server/broker-import/step9AcceptanceFixtureOperator.test.ts",
    "server/market-data/dhanHealthState.ts",
    "server/market-data/dhanHealthState.test.ts",
    "server/market-data/dhanHealthTransport.ts",
    "server/market-data/dhanHealthTransport.test.ts",
    "server/market-data/dhanMarketDataTransport.ts",
    "server/market-data/dhanMarketDataTransport.test.ts",
    "server/market-data/dhanMarketDataRoutes.ts",
    "server/market-data/dhanMarketDataRoutes.test.ts",
    "server/market-data/dhanSyntheticFixtures.ts",
    "server/market-data/dhanFreshnessRoutes.ts",
    "server/market-data/dhanFreshnessRoutes.test.ts"
  ]
}
